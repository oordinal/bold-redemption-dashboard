# Required: Alchemy API key (or a full RPC URL). Used for tx details, prices and builder tips.
ALCHEMY_API_KEY=your-alchemy-key

# Optional: public RPCs used for the event scan (Alchemy's free tier caps eth_getLogs at 10 blocks)
# LOGS_RPC_URLS=https://rpc.flashbots.net,https://ethereum-rpc.publicnode.com

# Optional: local server settings
SYNC_INTERVAL_MINUTES=5
PORT=3000

# Optional overrides. The verified Liquity V2 mainnet addresses are built into worker.js:
# BOLD_TOKEN_ADDRESS=0x6440f144b7e50D6a8439336510312d2F54beB01D
# LIQUITY_V2_REDEMPTION_ADDRESS=0xf949982B91C8c61e952B3bA942cbbfaef5386684
# UNISWAP_V3_POOL_ADDRESS_BOLD_USDC=0x1E4DBb639eBBF725fd243A6190dF5440eE38740E
# UNISWAP_V4_POOL_MANAGER=0x000000000004444c5dc75cB358380D2e3dE08A90
# UNISWAP_V4_POOL_ID_BOLD_USDC=0x5d0ed52610c76d7bf729130ce7ddc0488b2f4bd0a0db1f12adbe6a32deaff893
